{
  "name": "kady",
  "version": "1.0.0",
  "description": "Job hiring portal",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c yellow,cyan \"npm:dev --prefix backend\" \"npm:dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "clean": "node scripts/clean.js",
    "seed": "npm run seed --prefix backend"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "concurrently": "^10.0.4"
  }
}
